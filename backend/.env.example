NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://document_user:local_dev_password@localhost:5432/document_repository
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Optional. Leave empty to run without the search cache.
REDIS_URL=redis://localhost:6379
# Optional. The ClamAV daemon that scans uploads (docker compose --profile app runs one).
# Leave empty to skip scanning in development. When set, uploads are refused while it is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310
